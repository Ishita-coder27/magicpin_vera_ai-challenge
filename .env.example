# --- Mode ---------------------------------------------------------------
# challenge      : deterministic planner + validator; LLM polish if configured
# deterministic  : never call an LLM (fully reproducible, zero external calls)
MODE=challenge

# --- Optional LLM wording layer (never decides WHAT to send) -------------
# LLM_PROVIDER: anthropic | openai | groq | deepseek | openrouter | ollama
LLM_PROVIDER=
LLM_API_KEY=
# anthropic default: claude-opus-5 (low effort). For strict temperature=0
# determinism use a model that accepts sampling params, e.g. claude-haiku-4-5.
LLM_MODEL=
LLM_BASE_URL=
TEMPERATURE=0
LLM_TIMEOUT_S=6
REQUEST_BUDGET_S=9

# --- Metadata (/v1/metadata) ------------------------------------------------
TEAM_NAME=
TEAM_MEMBERS=
CONTACT_EMAIL=
SUBMITTED_AT=

LOG_LEVEL=INFO
